#!/usr/bin/env bash
# orch-index — launcher: runs the orch-index binary that fits this machine.
# Order: $ORCH_INDEX_REAL (explicit path), bin/vendor/orch-index-<target> bundled in this plugin,
# ${ORCH_DATA:-~/.claude/orch-data}/bin/orch-index (installed by orch-install-code-index.sh),
# then the first other orch-index on PATH. Never calls itself. Exit 127 if none is found.
set -u
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)

case "$(uname -s)/$(uname -m)" in
  Darwin/arm64|Darwin/aarch64) target=aarch64-apple-darwin ;;
  Darwin/x86_64)               target=x86_64-apple-darwin ;;
  Linux/x86_64|Linux/amd64)    target=x86_64-unknown-linux-musl ;;
  Linux/aarch64|Linux/arm64)   target=aarch64-unknown-linux-musl ;;
  *) target="" ;;
esac

try() { [ -n "$1" ] && [ -f "$1" ] && [ -x "$1" ] && exec "$1" "${@:2}"; }

[ -n "${ORCH_INDEX_REAL:-}" ] && try "$ORCH_INDEX_REAL" "$@"
[ -n "$target" ] && try "$here/vendor/orch-index-$target" "$@"
try "${ORCH_DATA:-$HOME/.claude/orch-data}/bin/orch-index" "$@"
IFS=:; for d in $PATH; do
  c="$d/orch-index"
  [ -f "$c" ] && [ -x "$c" ] && [ "$(cd "$d" && pwd -P)" != "$here" ] && exec "$c" "$@"
done
echo "orch-index: no binary for ${target:-this platform}; run orch-install-code-index.sh or see https://github.com/ijat/orch-index#install" >&2
exit 127

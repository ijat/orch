#!/usr/bin/env python3
"""orch — orchestration bookkeeping CLI (launcher). Code lives in orchlib/ next to this file."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

if sys.argv[1:2] == ["session-start"]:  # SessionStart hook (orch-session-start.sh ROOT): ACTIVE.md and the pointer
    from orchlib.paths import refresh_index, update_pointer, warn_stderr, writes_allowed  # noqa: E402
    if len(sys.argv) != 3:
        sys.stderr.write("usage: orch session-start PLUGIN_ROOT\n")
        sys.exit(1)
    if writes_allowed():   # a dev copy not told where to write leaves the real ACTIVE.md alone too
        refresh_index(warn_stderr)
    rc = 0
    try:
        update_pointer(sys.argv[2])
    except OSError as exc:
        sys.stderr.write("orch session-start: pointer not updated: %s\n" % exc)
        rc = 3
    try:  # with agent_docs on, one context line (stdout) names agent docs that are still real files here
        from orchlib.gitguard import switch_on  # noqa: E402
        if switch_on():
            from orchlib import docs  # noqa: E402
            line = docs.session_nudge(os.getcwd())
            if line:
                sys.stdout.write(line + "\n")
    except BaseException:  # never changes the exit code
        pass
    sys.exit(rc)

if sys.argv[1:3] == ["hook", "delegate"]:  # PreToolUse hook: skip loading the whole CLI (about 25 ms)
    from orchlib.hook import run  # noqa: E402
    sys.exit(run())

if sys.argv[1:3] == ["hook", "tier"]:  # PreToolUse hook on the Agent tool: same early path
    from orchlib.tierguard import run  # noqa: E402
    sys.exit(run())

if sys.argv[1:3] == ["hook", "ask"]:  # PreToolUse hook on the AskUserQuestion tool: same early path
    from orchlib.askguard import run  # noqa: E402
    sys.exit(run())

if sys.argv[1:3] == ["hook", "git-guard"]:  # PreToolUse hook on the Bash tool: same early path; exits at once with the switch off
    from orchlib.gitguard import run  # noqa: E402
    sys.exit(run())

from orchlib.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
"""orch — orchestration bookkeeping CLI (launcher). Code lives in orchlib/ next to this file."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

if sys.argv[1:3] == ["hook", "delegate"]:  # PreToolUse hook: skip loading the whole CLI (about 25 ms)
    from orchlib.hook import run  # noqa: E402
    sys.exit(run())

from orchlib.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
